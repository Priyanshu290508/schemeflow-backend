# ==========================================
# SchemeFlow - Backend Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="SchemeFlow API"
API_V1_STR="/api"

# Python Version (for Render.com build)
PYTHON_VERSION="3.12.0"

# Server Port (automatically injected by Render in production, default 8000 for local)
PORT=8000

# Database Connection URL (SQLite default for local, or PostgreSQL in production)
DATABASE_URL="sqlite:///./schemeflow.db"
# Example PostgreSQL for Render / Supabase / Neon:
# DATABASE_URL="postgresql://user:password@hostname:5432/schemeflow"

# Allowed CORS Origins (comma separated or wildcard in development)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175,*"
